{
  "manifest_version": 3,
  "name": "YTDownloader",
  "version": "1.0",
  "description": "Download YouTube videos in the best quality with yt-dlp",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  }
}
