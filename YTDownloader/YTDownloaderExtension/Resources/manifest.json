{
  "manifest_version": 3,
  "name": "YTDownloader",
  "version": "1.0",
  "description": "Download YouTube and VK Video in the best quality with yt-dlp",
  "permissions": [
    "nativeMessaging",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.vkvideo.ru/*",
    "*://vkvideo.ru/*",
    "*://*.vk.com/*",
    "*://vk.com/*",
    "*://*.vk.ru/*",
    "*://vk.ru/*"
  ],
  "optional_host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.google.com/*",
    "*://google.com/*",
    "*://*.vkvideo.ru/*",
    "*://vkvideo.ru/*",
    "*://*.vk.com/*",
    "*://vk.com/*",
    "*://*.vk.ru/*",
    "*://vk.ru/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.vkvideo.ru/*",
        "*://vkvideo.ru/*",
        "*://*.vk.com/*",
        "*://vk.com/*",
        "*://*.vk.ru/*",
        "*://vk.ru/*"
      ],
      "js": ["vk.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "YTDownloader",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png",
      "128": "icon-128.png"
    }
  }
}
